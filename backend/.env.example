# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# AI & Voice Services (Blueprint Phase 2)
GEMINI_API_KEY=your_gemini_flash_api_key_here
GROQ_API_KEY=your_groq_fallback_api_key_here
WHISPER_CPP_PATH=/usr/local/bin/whisper
WHISPER_MODEL_PATH=/models/ggml-base.bin

# WhatsApp Cloud API (Blueprint Phase 3)
WHATSAPP_API_TOKEN=your_meta_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=msme_assistant_webhook_secret_2026
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# PostgreSQL & Redis Database (Blueprint Phase 1)
DATABASE_URL=postgresql://msme_user:msme_password@localhost:5432/msme_db?schema=public
REDIS_URL=redis://localhost:6379

# Cloudflare R2 Storage (Blueprint Infrastructure)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=msme-invoices-store
